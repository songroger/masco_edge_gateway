    "keepalive": 60,
    "tls": {
      "enable": false,
      "ca_certs": "/etc/edge_collector/certs/ca.crt",
      "certfile": "",
      "keyfile": "",
      "insecure": false
    }
  },

  "database": {
    "path": "./edge_collector.db",
    "max_records": 100000,
    "max_retry": 50
  },

  "collect": {
    "interval": 10,
    "upload_interval": 60,
    "request_timeout": 2,
    "retry": 2,
    "batch_max_gap": 8,
    "batch_max_count": 64
  },

  "watchdog": {
    "enable": true,
    "mqtt_restart_after": 3,
    "rs485_restart_after": 3,
    "sqlite_restart_after": 1
  },

  "gpio": {
    "chip": "/dev/gpiochip0",
    "consumer": "edge-collector"
  },

