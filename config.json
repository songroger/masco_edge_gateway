  "rules": [
    {
      "name": "device_over_temp_stop_charge",
      "type": "threshold",
      "source": "RS485_1:1:device_over_temp",
      "operator": "==",
      "threshold": 1,
      "consecutive": 2,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "critical",
          "code": "DEVICE_OVER_TEMP",
          "message": "MPPT device over-temperature, stop charging"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0000",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    },
    {
      "name": "high_device_temp_stop_charge",
      "type": "threshold",
      "source": "RS485_1:1:device_temp",
      "operator": ">=",
      "threshold": 75,
      "consecutive": 3,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "critical",
          "code": "HIGH_DEVICE_TEMP",
          "message": "MPPT device temperature too high, stop charging"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0000",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    },
    {
      "name": "battery_over_voltage_stop_charge",
      "type": "threshold",
      "source": "RS485_1:1:battery_voltage",
      "operator": ">=",
      "threshold": 58,
      "consecutive": 3,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "critical",
          "code": "BATTERY_OVER_VOLTAGE",
          "message": "Battery over-voltage, stop charging"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0000",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    },
    {
      "name": "low_soc_stop_load",
      "type": "threshold",
      "source": "RS485_1:1:battery_soc",
      "operator": "<=",
      "threshold": 20,
      "consecutive": 3,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "warning",
          "code": "LOW_SOC",
          "message": "Battery SOC low, turn off load output"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0002",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    },
    {
      "name": "over_load_current_stop_load",
      "type": "threshold",
      "source": "RS485_1:1:load_current",
      "operator": ">",
      "threshold": 20,
      "consecutive": 2,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "critical",
          "code": "OVER_LOAD_CURRENT",
          "message": "Load over-current, turn off load output"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0002",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    },
    {
      "name": "mppt_comm_fail",
      "type": "comm_fail",
      "source": "RS485_1:1",
      "consecutive": 5,
      "action": {
        "type": "dual",
        "alarm": {
          "severity": "critical",
          "code": "COMM_FAIL",
          "message": "MPPT controller consecutive Modbus read failures"
        },
        "modbus": {
          "port": "RS485_1",
          "slave_id": 1,
          "register_type": "coil",
          "address": "0x0000",
          "value": 0
        },
        "gpio": {
          "line": 17,
          "value": 1
        }
      }
    }
  ]
}
